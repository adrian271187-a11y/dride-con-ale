{
  "expo": {
    "name": "D'Ride Con Ale",
    "slug": "dride-con-ale",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#0A2A1E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.drideconale.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A2A1E"
      },
      "package": "com.drideconale.app"
    },
    "plugins": [
      "expo-router",
      "expo-notifications"
    ],
    "scheme": "dride"
  }
}
